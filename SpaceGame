    def set_text(self, item, s):
        if self.text_cache.get(item) != s:
            self.text_cache[item] = s
            self.canvas.itemconfigure(item, text=s)

    def refresh_fps_text(self):
        other = 60 if self.fps == 30 else 30
        self.set_text(self.hud_fps, "%d FPS (now %d)   F = switch" % (self.fps, self.fps_now))
        self.set_text(self.title_fps, "FPS: %d     press  F  for %d FPS" % (self.fps, other))

    # -----------------------------------------------------------
    # Starting a game / a level
    # -----------------------------------------------------------
    def reset(self):
        self.level = 1
        self.score = 0
        self.hp = START_HP
        self.hit_flash = 0
        self.fire_delay = START_FIRE_DELAY
        self.cannons = 1
        self.cleared = 0
        self.px, self.py = WIDTH / 2, HEIGHT - 85
        self.invuln = 0
        self.cooldown = 0.0
        self.reward_lines = []
        self.reward_timer = 0
        self.particles = []
        self.demo_bullets = []
        self.banner = 0
        self.to_spawn = 0
        self.spawn_timer = 0
        self.clear_field()

    def clear_field(self):
        self.enemies = []
        self.bullets = []          # your blue shots
        self.enemy_bullets = []    # their shots
        self.boss = None

    def start_game(self):
        self.reset()
        self.state = "playing"
        self.paused = False
        self.start_level()
        self.sound.play("start", True)

    def start_level(self):
        self.state = "playing"
        self.clear_field()
        self.to_spawn = min(24, 4 + self.level)     # circle minions this level
        self.spawn_timer = 50
        self.cooldown = 0.0
        self.banner = 110

    def boss_health(self, lvl):
        """How tough is the boss? We work out how much damage per second your
        ship does at this level, then give the boss enough health to last a
        fair fight (longer fights on later levels)."""
        delay = max(MIN_FIRE_DELAY, START_FIRE_DELAY * FIRE_SPEEDUP ** (lvl - 1))
        cannons = min(MAX_CANNONS, 1 + (lvl - 1) // 5)
        dps = cannons * 60.0 / delay
        seconds = 7 + 1.3 * lvl
        hp = dps * seconds * 0.45          # 0.45 = we expect ~half your shots to hit
        if lvl == FINAL_LEVEL:
            hp *= 1.6
        return int(hp)

    def make_boss(self):
        lvl = self.level
        final = lvl == FINAL_LEVEL
        hp = self.boss_health(lvl)
        self.boss = {
            "x": WIDTH / 2, "y": -140.0, "t": 0, "arrived": False,
            "w": 190 + lvl * 4 if not final else 250,
            "h": 110 + lvl * 2 if not final else 150,
            "home_y": BOSS_Y + (25 if final else 0),
            "hp": hp, "max_hp": hp, "flash": 0, "flash_cd": 0, "dir": 1,
            "speed": 1.4 + lvl * 0.1,
            "attack_timer": 90, "attacks": 0, "summon": 300,
        }
        self.banner = 120

    def spawn_minion(self, x, y):
        lvl = self.level
        self.enemies.append({
            "x": x, "y": y, "x0": x, "t": random.randint(0, 100),
            "amp": random.randint(20, 70),
            "hp": 1 + lvl // 6,
            "speed": 1.2 + lvl * 0.08,
            "shoot": random.randint(60, 150),
            "color": MINION_COLORS[(lvl - 1) % len(MINION_COLORS)],
        })

    # -----------------------------------------------------------
    # Keyboard
    # -----------------------------------------------------------
    def key_down(self, event):
        key = event.keysym.lower()
        self.keys.add(key)
        if self.state == "title" and key in ("space", "return"):
            self.start_game()
        elif key == "r" and self.state in ("gameover", "win"):
            self.start_game()
        elif key == "f":
            self.fps = 60 if self.fps == 30 else 30
            self.refresh_fps_text()
        elif key == "m":
            self.sound.enabled = not self.sound.enabled
            if not self.sound.enabled:
                self.sound.stop()
        elif key == "p" and self.state == "playing":
            self.paused = not self.paused

    def key_up(self, event):
        self.keys.discard(event.keysym.lower())

    def focus_out(self, event):
        """If you click another window, let go of all keys and pause."""
        if event.widget is self.root:
            self.keys.clear()
            if self.state == "playing":
                self.paused = True

    def close(self):
        self.running = False
        self.sound.stop()
        self.root.destroy()

    # -----------------------------------------------------------
    # Main loop.  The RULES run exactly 60 times per second, always.
    # Only the DRAWING happens at 30 or 60 FPS (your choice), and if the
    # laptop is slow the drawing is skipped so the game never slows down.
    # -----------------------------------------------------------
    def loop(self):
        if not self.running:
            return
        now = time.perf_counter()
        self.acc += min(now - self.last_tick, 0.25)
        self.last_tick = now
        try:
            steps = 0
            while self.acc >= STEP and steps < 5:
                self.update()
                self.acc -= STEP
                steps += 1
            if steps == 5:
                self.acc = 0.0              # too slow to catch up: forget the backlog
            self.draw()
            self.draw_count += 1
            if now - self.fps_clock >= 1.0:
                self.fps_now = self.draw_count
                self.draw_count = 0
                self.fps_clock = now
                self.refresh_fps_text()
            self.good_frames += 1
            if self.good_frames > 120:
                self.errors = 0
        except tk.TclError:
            return                          # the window was closed
        except Exception:
            # A bug must never throw you out of the game: show it, go to the title.
            traceback.print_exc()
            self.errors += 1
            self.good_frames = 0
            if self.errors > 3:
                self.running = False
                return
            self.reset()
            self.state = "title"
        spent = time.perf_counter() - now
        self.root.after(max(1, int((1.0 / self.fps - spent) * 1000)), self.loop)

    # -----------------------------------------------------------
    # UPDATE: move everything and check hits (no drawing in here)
    # -----------------------------------------------------------
    def update(self):
        self.t += 1
        self.update_stars()
        if self.paused:
            return
        self.update_particles()
        if self.hit_flash > 0:
            self.hit_flash -= 1

        if self.state == "title":
            self.update_title()
        elif self.state == "reward":
            if self.t % 10 == 0:        # little fireworks
                self.burst(random.randint(80, WIDTH - 80), random.randint(120, 300),
                           random.choice(["#ff77ff", "#77ddff", "#ffee77", "#88ff99"]), 12, 3.5)
            self.reward_timer -= 1
            if self.reward_timer <= 0:
                self.level += 1
                self.start_level()
        elif self.state == "playing":
            if self.banner > 0:
                self.banner -= 1
            if self.invuln > 0:
                self.invuln -= 1
            self.move_player()
            self.shoot()
            self.spawn_enemies()
            self.move_enemies()
            self.move_boss()
            self.move_bullets()
            self.check_hits()

    def update_title(self):
        # decoration only: the ship on the title screen fires pretend shots
        if self.t % 14 == 0:
            self.demo_bullets.append([WIDTH / 2, 575])
        self.demo_bullets = [[x, y - 9] for x, y in self.demo_bullets if y > 380]

    def update_particles(self):
        alive = []
        for p in self.particles:
            p[0] += p[2]
            p[1] += p[3]
            p[4] -= 1
            if p[4] > 0:
                alive.append(p)
        self.particles = alive[-120:]

    def burst(self, x, y, color, count, speed):
        for _ in range(count):
            a = random.uniform(0, 2 * math.pi)
            v = random.uniform(0.3, 1.0) * speed
            life = random.randint(18, 36)
            self.particles.append([x, y, math.cos(a) * v, math.sin(a) * v,
                                   life, life, color, random.choice([2, 3, 3, 4])])

    def move_player(self):
        if "left" in self.keys or "a" in self.keys:
            self.px -= PLAYER_SPEED
        if "right" in self.keys or "d" in self.keys:
            self.px += PLAYER_SPEED
        self.px = max(30, min(WIDTH - 30, self.px))

    def shoot(self):
        self.cooldown = max(self.cooldown - 1, -1)
        if "space" in self.keys and self.cooldown <= 0:
            for dx, dy in CANNON_POS[self.cannons]:
                self.bullets.append([self.px + dx, self.py + dy - 4])
            self.cooldown += self.fire_delay
            self.sound.play("shoot")

    def spawn_enemies(self):
        if self.to_spawn > 0:
            self.spawn_timer -= 1
            if self.spawn_timer <= 0:
                self.spawn_minion(random.randint(40, WIDTH - 40), -20)
                self.to_spawn -= 1
                self.spawn_timer = max(16, 42 - self.level)
        elif not self.enemies and self.boss is None:
            self.make_boss()            # all minions gone -> the BOSS arrives

    def move_enemies(self):
        alive = []
        for e in self.enemies:
            e["y"] += e["speed"]
            e["t"] += 1
            e["x"] = max(20, min(WIDTH - 20, e["x0"] + e["amp"] * math.sin(e["t"] * 0.04)))
            if self.level >= 2 and e["y"] > 0:       # from level 2 minions shoot
                e["shoot"] -= 1
                if e["shoot"] <= 0:
                    self.enemy_bullets.append([e["x"], e["y"] + 14, 0, 3.6, 1])   # 1 = half a heart
                    e["shoot"] = max(55, 160 - self.level * 5)
            if e["y"] < HEIGHT + 30:
                alive.append(e)
        self.enemies = alive

    def move_boss(self):
        b = self.boss
        if not b:
            return
        b["t"] += 1
        if b["flash"] > 0:
            b["flash"] -= 1
        if b["flash_cd"] > 0:
            b["flash_cd"] -= 1
        if not b["arrived"]:                        # fly in from the top
            b["y"] += 2.5
            if b["y"] >= b["home_y"]:
                b["arrived"] = True
            return
        lvl = self.level
        enraged = b["hp"] < b["max_hp"] * 0.4       # angry when nearly dead
        speed = b["speed"] * (1.35 if enraged else 1.0)
        b["x"] += b["dir"] * speed
        margin = b["w"] * 0.6 + 4                   # keep the wings on the screen
        if b["x"] > WIDTH - margin:
            b["dir"] = -1
        if b["x"] < margin:
            b["dir"] = 1
        b["y"] = b["home_y"] + 8 * math.sin(b["t"] * 0.05)

        # --- boss shots (a boss shot takes a whole heart = 2 half hearts) ---
        b["attack_timer"] -= 1
        if b["attack_timer"] <= 0:
            b["attack_timer"] = max(32, 85 - lvl * 2) * (0.75 if enraged else 1.0)
            b["attacks"] += 1
            speed = min(5.0, 3.2 + lvl * 0.1)
            count = 3 + lvl // 5 + (1 if enraged else 0)
            for i in range(count):                  # a fan of shots going down
                ang = math.pi / 2 + (-0.45 + 0.9 * i / (count - 1))
                self.enemy_bullets.append([b["x"], b["y"] + b["h"] / 2,
                                           math.cos(ang) * speed, math.sin(ang) * speed, 2])
            if lvl >= 6:                            # one shot aimed at YOU
                dx, dy = self.px - b["x"], self.py - b["y"]
                d = math.hypot(dx, dy) or 1
                self.enemy_bullets.append([b["x"], b["y"], dx / d * speed * 1.1,
                                           dy / d * speed * 1.1, 2])
            if lvl >= 12 and b["attacks"] % 3 == 0:  # a slow ring of small shots
                for i in range(12):
                    ang = 2 * math.pi * i / 12
                    self.enemy_bullets.append([b["x"], b["y"], math.cos(ang) * 2.6,
                                               math.sin(ang) * 2.6, 1])

        # --- the boss calls in circle-ship minions ---
        if lvl >= 3:
            b["summon"] -= 1
            if b["summon"] <= 0:
                b["summon"] = max(220, 440 - lvl * 10)
                if len(self.enemies) < 4:
                    self.spawn_minion(b["x"] - b["w"] / 2, b["y"] + 20)
                    self.spawn_minion(b["x"] + b["w"] / 2, b["y"] + 20)

    def move_bullets(self):
        self.bullets = [[x, y - 11] for x, y in self.bullets if y > -15]
        moved = []
        for x, y, vx, vy, dmg in self.enemy_bullets:
            x += vx
            y += vy
            if -10 < x < WIDTH + 10 and -10 < y < HEIGHT + 10:
                moved.append([x, y, vx, vy, dmg])
        self.enemy_bullets = moved

    def check_hits(self):
        boss = self.boss if (self.boss and self.boss["arrived"]) else None
        remaining = []
        for bx, by in self.bullets:
            hit = False
            for e in self.enemies:
                if abs(bx - e["x"]) < 18 and abs(by - e["y"]) < 18:
                    e["hp"] -= 1
                    hit = True
                    if e["hp"] <= 0:
                        self.kill_minion(e)
                    break
            if not hit and boss and abs(bx - boss["x"]) < boss["w"] * 0.5 \
                    and abs(by - boss["y"]) < boss["h"] * 0.5:
                boss["hp"] -= 1
                if boss["flash_cd"] == 0:           # quick white blink, not constant
                    boss["flash"] = 2
                    boss["flash_cd"] = 12
                self.score += 1
                hit = True
                if random.random() < 0.2:
                    self.burst(bx, by, "#7fc8ff", 2, 2.5)
            if not hit:
                remaining.append([bx, by])
        self.bullets = remaining
        self.enemies = [e for e in self.enemies if e["hp"] > 0]

        if boss and boss["hp"] <= 0:
            self.level_cleared()
            return

        if self.invuln == 0:                        # their shots / ships hit YOU
            for eb in self.enemy_bullets:
                if math.hypot(eb[0] - self.px, eb[1] - (self.py - 2)) < 14:
                    self.enemy_bullets.remove(eb)
                    self.lose_hp(eb[4])
                    return
            for e in self.enemies:
                if math.hypot(e["x"] - self.px, e["y"] - self.py) < 28:
                    self.kill_minion(e)
                    self.enemies.remove(e)
                    self.lose_hp(2)                 # crashing into a ship = 1 heart
                    return

    def kill_minion(self, e):
        self.score += 10
        self.burst(e["x"], e["y"], e["color"], 10, 3.2)
        self.sound.play("boom")

    def lose_hp(self, amount):
        self.hp = max(0, self.hp - amount)
        self.invuln = HIT_INVULN                    # short protection after a hit
        self.hit_flash = 24                         # the hearts blink white
        self.burst(self.px, self.py, "#ff5577", 12, 3.5)
        if self.hp <= 0:
            self.state = "gameover"
            self.burst(self.px, self.py, "#ffaa55", 30, 5)
            self.sound.play("gameover", True)
        else:
            self.sound.play("hurt", True)

    def level_cleared(self):
        b = self.boss
        self.score += 100 * self.level
        for col in ("#ffdd66", "#ff7755", "#ffffff", "#ff77ff"):
            self.burst(b["x"], b["y"], col, 20, 6)
        self.boss = None
        self.enemy_bullets = []
        self.enemies = []
        self.bullets = []

        if self.level >= FINAL_LEVEL:
            self.state = "win"
            self.sound.play("win", True)
            return

        # ----- REWARDS -----
        self.cleared += 1
        self.reward_lines = []
        old = 60 / self.fire_delay
        self.fire_delay = max(MIN_FIRE_DELAY, self.fire_delay * FIRE_SPEEDUP)
        self.reward_lines.append("FASTER CANNONS   %.1f -> %.1f shots/sec"
                                 % (old, 60 / self.fire_delay))
        if self.cleared % 5 == 0 and self.cannons < MAX_CANNONS:
            self.cannons += 1
            self.reward_lines.append("EXTRA CANNON!   now %d cannons" % self.cannons)
        if self.hp < MAX_HP:
            self.hp = min(MAX_HP, self.hp + HEAL_PER_BOSS)
            self.reward_lines.append("+1 HEART")
        self.state = "reward"
        self.reward_timer = 170
        self.sound.play("fanfare", True)            # the victory jingle!

    # -----------------------------------------------------------
    # DRAWING helpers (things drawn fresh every frame have the tag "dyn")
    # -----------------------------------------------------------
    def poly(self, pts, fill, outline="#ffffff", width=1):
        self.canvas.create_polygon(pts, fill=fill, outline=outline, width=width, tags="dyn")

    def oval(self, x, y, rx, ry, fill="", outline="", width=1):
        self.canvas.create_oval(x - rx, y - ry, x + rx, y + ry, fill=fill,
                                outline=outline, width=width, tags="dyn")

    def text(self, x, y, s, size=12, color="#ffffff", anchor="center", bold=True):
        self.canvas.create_text(x, y, text=s, fill=color, anchor=anchor, tags="dyn",
                                font=("Arial", size, "bold" if bold else "normal"))

    @staticmethod
    def rel(x, y, w, h, pts):
        """Turn shape points written as -1..1 into real screen positions."""
        flat = []
        for px, py in pts:
            flat += [x + px * w / 2, y + py * h / 2]
        return flat

    # -----------------------------------------------------------
    # DRAW: put everything on the screen
    # -----------------------------------------------------------
    def draw(self):
        c = self.canvas
        c.delete("dyn")
        self.sync_scene()
        self.draw_stars()

        if self.state == "title":
            self.pool_mine.update([(x, y, x, y + 13) for x, y in self.demo_bullets])
            self.pool_theirs.update([])
            self.pool_sparks.update([])
            self.draw_title()
            return

        self.pool_mine.update([(x, y, x, y + 13) for x, y in self.bullets])
        self.pool_theirs.update([(x - 6, y - 6, x + 6, y + 6) for x, y, vx, vy, dm in self.enemy_bullets])
        shapes, cols = [], []
        for x, y, vx, vy, life, maxlife, col, size in self.particles:
            h = size / 2
            shapes.append((x - h, y - h, x + h, y + h))
            cols.append(mix(col, "#07030f", 1 - int(life * 4 / maxlife) / 4.0))
        self.pool_sparks.update(shapes, cols)

        for e in self.enemies:
            self.draw_minion(e["x"], e["y"], 16, e["color"], self.t)
        if self.boss:
            self.draw_boss()
        if self.state != "gameover":
            blink = self.invuln > 0 and (self.invuln // 5) % 2 == 0
            if not blink:
                self.draw_player(self.px, self.py, self.cannons)

        self.draw_hud()
        c.tag_raise("hud")                  # hearts and score always stay on top
        self.draw_messages()

    # ---- your spaceship ----------------------------------------
    def draw_player(self, x, y, cannons):
        flame = 9 + random.random() * 7
        for s in (-1, 1):                                   # engine flames
            self.poly([x + s * 8, y + 18, x + s * 5, y + 18 + flame, x + s * 2, y + 18],
                      "#ff9a3d", "#ffe08a")
            self.poly([x + s * 6.5, y + 18, x + s * 5, y + 18 + flame * 0.55, x + s * 3.5, y + 18],
                      "#fff3b0", "")
        for s in (-1, 1):                                   # swept-back wings
            self.poly([x + s * 8, y - 2, x + s * 27, y + 15, x + s * 30, y + 26, x + s * 9, y + 17],
                      "#5b6bd6", "#dfe6ff", 1)
            self.poly([x + s * 19, y + 10, x + s * 27, y + 15, x + s * 30, y + 26, x + s * 22, y + 20],
                      "#3fb8ff", "")
        self.poly([x, y - 32, x + 7, y - 16, x + 10, y + 4, x + 8, y + 18,   # main body
                   x - 8, y + 18, x - 10, y + 4, x - 7, y - 16],
                  "#dfe6ff", "#ffffff", 1)
        self.poly([x, y - 24, x + 3, y - 8, x + 3, y + 14, x - 3, y + 14, x - 3, y - 8],
                  "#8aa0ff", "")
        self.poly([x, y - 32, x + 3.5, y - 23, x - 3.5, y - 23], "#ff4d6d", "")   # red nose
        self.oval(x, y - 6, 4.5, 8.5, fill="#33d6ff", outline="#ffffff")           # cockpit
        self.oval(x - 1.5, y - 9, 1.3, 3, fill="#ffffff")
        for dx, dy in CANNON_POS[cannons]:                  # blue cannons
            self.oval(x + dx, y + dy, 5.5, 5.5, outline="#2f7bff", width=2)
            self.oval(x + dx, y + dy, 3.5, 3.5, fill="#3fa9ff", outline="#d6ecff")

    # ---- the circle-ship minions -------------------------------
    def draw_minion(self, x, y, r, color, t):
        self.oval(x, y, r, r, fill=color, outline="#ffffff", width=2)
        self.oval(x, y, r * 0.66, r * 0.66, fill=mix(color, "#000000", 0.5), outline="")
        self.oval(x, y, r * 0.36, r * 0.36, fill="#aef4ff", outline="#ffffff")   # glass dome
        a = t * 0.09
        for k in (0, 2):                                    # two spinning lights
            self.oval(x + math.cos(a + k * math.pi / 2) * r * 0.8,
                      y + math.sin(a + k * math.pi / 2) * r * 0.8, 2.3, 2.3, fill="#fff3a0")

    # ---- the big bosses ----------------------------------------
    def draw_boss(self):
        b = self.boss
        lvl = self.level
        hull, plate, glow = BOSS_PALETTES[(lvl - 1) % len(BOSS_PALETTES)]
        if lvl == FINAL_LEVEL:
            hull, plate, glow = "#2b0f1f", "#8a1634", "#ff3b3b"
        if b["flash"] > 0:                                  # flash white when hit
            hull, plate = mix(hull, "#ffffff", 0.6), mix(plate, "#ffffff", 0.6)
        pulse = 0.5 + 0.5 * math.sin(self.t * 0.12)
        args = (b["x"], b["y"], b["w"], b["h"], hull, plate, glow, pulse)
        if lvl == FINAL_LEVEL:
            self.boss_dreadnought(*args)
        else:
            [self.boss_warship, self.boss_manta, self.boss_fortress,
             self.boss_crab, self.boss_stinger][(lvl - 1) % 5](*args)

        # health bar
        frac = max(0, b["hp"]) / b["max_hp"]
        bar = mix("#ff3333", "#ffcc33", frac)
        self.canvas.create_rectangle(60, 32, WIDTH - 60, 43, outline="#ffffff", tags="dyn")
        self.canvas.create_rectangle(61, 33, 61 + (WIDTH - 122) * frac, 42, fill=bar,
                                     outline="", tags="dyn")
        name = BOSS_NAMES[lvl - 1]
        self.text(WIDTH / 2, 20, ("FINAL BOSS - " if lvl == FINAL_LEVEL else "BOSS - ") + name,
                  11, "#ffffff")

    def glow_orb(self, x, y, r, color, pulse):
        self.oval(x, y, r + 4 + 3 * pulse, r + 4 + 3 * pulse, fill=mix(color, "#000000", 0.55))
        self.oval(x, y, r, r, fill=color, outline="#ffffff", width=1)
        self.oval(x, y, r * 0.45, r * 0.45, fill="#ffffff")

    def boss_warship(self, x, y, w, h, hull, plate, glow, pulse):
        P = lambda pts: self.rel(x, y, w, h, pts)
        edge = mix(hull, "#ffffff", 0.7)
        for s in (-1, 1):
            self.poly(P([(s * 0.4 - 0.12, -0.9), (s * 0.4, -1.2 - 0.15 * pulse), (s * 0.4 + 0.12, -0.9)]),
                      "#ffb347", "#fff3c0")
            self.poly(P([(s * 0.5, -0.6), (s * 1.1, -0.1), (s * 1.1, 0.5), (s * 0.8, 0.95), (s * 0.5, 0.4)]),
                      hull, edge, 2)
            self.poly(P([(s * 0.8 - 0.08, 0.5), (s * 0.8 + 0.08, 0.5), (s * 0.8 + 0.08, 1.05), (s * 0.8 - 0.08, 1.05)]),
                      plate, edge)
            self.oval(x + s * 0.8 * w / 2, y + 1.05 * h / 2, 5, 5, fill=glow, outline="#ffffff")
        self.poly(P([(-0.55, -0.95), (0.55, -0.95), (0.85, -0.2), (0.6, 0.75), (0.25, 1), (-0.25, 1),
                     (-0.6, 0.75), (-0.85, -0.2)]), hull, edge, 2)
        self.poly(P([(-0.35, -0.7), (0.35, -0.7), (0.55, -0.15), (0.4, 0.5), (-0.4, 0.5), (-0.55, -0.15)]),
                  plate, edge)
        self.glow_orb(x, y - 0.05 * h / 2, 0.2 * h / 2 + 3, glow, pulse)

    def boss_manta(self, x, y, w, h, hull, plate, glow, pulse):
        P = lambda pts: self.rel(x, y, w, h, pts)
        edge = mix(hull, "#ffffff", 0.7)
        self.poly(P([(-0.07, 0.9), (0, 1.35), (0.07, 0.9)]), plate, edge)          # tail spike
        self.poly(P([(0, -0.95), (1.1, -0.5), (1.0, 0.0), (0.45, 0.1), (0.3, 0.75), (0, 1.0),
                     (-0.3, 0.75), (-0.45, 0.1), (-1.0, 0.0), (-1.1, -0.5)]), hull, edge, 2)
        self.poly(P([(0, -0.7), (0.7, -0.4), (0.35, 0.0), (0.2, 0.6), (0, 0.8), (-0.2, 0.6),
                     (-0.35, 0.0), (-0.7, -0.4)]), plate, edge)
        for s in (-1, 1):
            self.canvas.create_line(*P([(s * 0.25, -0.45), (s * 0.9, -0.3)]), fill=glow, width=3,
                                    capstyle="round", tags="dyn")
            self.oval(x + s * 0.15 * w / 2, y - 0.1 * h / 2, 7, 7 + 2 * pulse, fill=glow, outline="#ffffff")
            self.oval(x + s * 1.0 * w / 2, y - 0.05 * h / 2, 5, 5, fill=glow, outline="#ffffff")

    def boss_fortress(self, x, y, w, h, hull, plate, glow, pulse):
        P = lambda pts: self.rel(x, y, w, h, pts)
        edge = mix(hull, "#ffffff", 0.7)
        for sx in (-0.7, 0, 0.7):                                                  # towers
            self.poly(P([(sx - 0.2, -1.05), (sx + 0.2, -1.05), (sx + 0.2, -0.8), (sx - 0.2, -0.8)]), plate, edge)
        self.poly(P([(-0.9, -0.85), (0.9, -0.85), (0.9, 0.55), (-0.9, 0.55)]), hull, edge, 2)
        self.poly(P([(-0.75, -0.6), (0.75, -0.6), (0.75, 0.3), (-0.75, 0.3)]), plate, edge)
        for i in range(5):                                                         # lit windows
            wx = -0.6 + 0.3 * i
            lit = glow if (i + int(self.t / 12)) % 2 == 0 else mix(glow, "#000000", 0.6)
            self.poly(P([(wx - 0.06, -0.35), (wx + 0.06, -0.35), (wx + 0.06, -0.05), (wx - 0.06, -0.05)]), lit, "")
        for sx in (-0.65, 0, 0.65):                                                # turrets
            bw = 0.11 if sx == 0 else 0.08
            self.poly(P([(sx - bw, 0.55), (sx + bw, 0.55), (sx + bw, 1.1), (sx - bw, 1.1)]), plate, edge)
            self.oval(x + sx * w / 2, y + 1.1 * h / 2, 6, 6, fill=glow, outline="#ffffff")
        self.glow_orb(x, y - 0.7 * h / 2 + 2, 8, glow, pulse)

    def boss_crab(self, x, y, w, h, hull, plate, glow, pulse):
        P = lambda pts: self.rel(x, y, w, h, pts)
        edge = mix(hull, "#ffffff", 0.7)
        for lx in (-0.35, 0, 0.35):                                                # legs
            self.canvas.create_line(*P([(lx * 0.8, 0.5), (lx * 1.8, 1.1)]), fill=edge, width=4,
                                    capstyle="round", tags="dyn")
        for s in (-1, 1):                                                          # claws
            self.poly(P([(s * 0.55, -0.2), (s * 1.0, -0.8), (s * 1.2, -0.1), (s * 1.0, 0.65),
                         (s * 0.85, 0.1), (s * 0.65, 0.3)]), hull, edge, 2)
            self.poly(P([(s * 0.9, -0.5), (s * 1.1, -0.1), (s * 0.95, 0.35), (s * 0.85, 0.0)]), plate, edge)
            self.oval(x + s * 1.05 * w / 2, y + 0.55 * h / 2, 5, 5, fill=glow, outline="#ffffff")
        self.poly(P([(-0.5, -0.7), (0.5, -0.7), (0.75, 0), (0.45, 0.75), (-0.45, 0.75), (-0.75, 0)]), hull, edge, 2)
        self.poly(P([(-0.3, -0.45), (0.3, -0.45), (0.5, 0), (0.3, 0.5), (-0.3, 0.5), (-0.5, 0)]), plate, edge)
        for s in (-1, 1):                                                          # eyes on stalks
            self.canvas.create_line(*P([(s * 0.2, -0.6), (s * 0.3, -1.05)]), fill=edge, width=3, tags="dyn")
            self.glow_orb(x + s * 0.3 * w / 2, y - 1.05 * h / 2, 8, glow, pulse)

    def boss_stinger(self, x, y, w, h, hull, plate, glow, pulse):
        P = lambda pts: self.rel(x, y, w, h, pts)
        edge = mix(hull, "#ffffff", 0.7)
        self.poly(P([(0, 1.15), (0.3, 0.3), (1.05, 0.15), (0.45, -0.2), (0.6, -1.05), (0, -0.55),
                     (-0.6, -1.05), (-0.45, -0.2), (-1.05, 0.15), (-0.3, 0.3)]), hull, edge, 2)
        self.poly(P([(0, 0.85), (0.2, 0.25), (0.6, 0.1), (0.3, -0.2), (0, -0.3), (-0.3, -0.2),
                     (-0.6, 0.1), (-0.2, 0.25)]), plate, edge)
        for s in (-1, 1):
            self.oval(x + s * 0.6 * w / 2, y - 0.95 * h / 2, 4, 4, fill=glow, outline="#ffffff")
            self.oval(x + s * 1.05 * w / 2, y + 0.15 * h / 2, 5, 5, fill=glow, outline="#ffffff")
        self.oval(x, y + 1.15 * h / 2, 5, 5, fill=glow, outline="#ffffff")
        self.glow_orb(x, y - 0.05 * h / 2, 12, glow, pulse)

    def boss_dreadnought(self, x, y, w, h, hull, plate, glow, pulse):
        """The FINAL boss: bigger, with a golden crown and a burning red core."""
        P = lambda pts: self.rel(x, y, w, h, pts)
        edge = mix(hull, "#ffffff", 0.7)
        gold = "#ffcc33"
        for s in (-1, 1):
            self.poly(P([(s * 0.4, -0.7), (s * 1.15, -0.95), (s * 1.1, -0.4), (s * 1.2, 0.1),
                         (s * 0.95, 0.3), (s * 0.9, 0.8), (s * 0.45, 0.5)]), hull, edge, 2)
            self.poly(P([(s * 0.55, -0.5), (s * 1.0, -0.7), (s * 0.95, -0.2), (s * 0.6, 0.0)]), plate, edge)
            for k in (0, 1):
                gx, gy = s * (0.72 + 0.2 * k), 0.5 + 0.25 * k
                self.poly(P([(gx - 0.05, gy), (gx + 0.05, gy), (gx + 0.05, gy + 0.3), (gx - 0.05, gy + 0.3)]),
                          plate, edge)
                self.oval(x + gx * w / 2, y + (gy + 0.3) * h / 2, 5, 5, fill=glow, outline="#ffffff")
        self.poly(P([(-0.5, -0.9), (0.5, -0.9), (0.7, -0.3), (0.55, 0.7), (0.25, 1.0), (-0.25, 1.0),
                     (-0.55, 0.7), (-0.7, -0.3)]), hull, edge, 2)
        for i in range(5):                                                         # golden crown
            xx = -0.4 + 0.2 * i
            tip = -1.35 if i % 2 == 0 else -1.15
            self.poly(P([(xx - 0.08, -0.88), (xx, tip), (xx + 0.08, -0.88)]), gold, "#fff0b0")
        self.poly(P([(-0.4, -0.6), (0.4, -0.6), (0.5, -0.1), (0.35, 0.55), (-0.35, 0.55), (-0.5, -0.1)]),
                  plate, edge)
        for sx in (-0.35, 0, 0.35):
            self.poly(P([(sx - 0.06, 0.7), (sx + 0.06, 0.7), (sx + 0.06, 1.1), (sx - 0.06, 1.1)]), gold, "#fff0b0")
            self.oval(x + sx * w / 2, y + 1.1 * h / 2, 5, 5, fill=glow, outline="#ffffff")
        self.glow_orb(x, y - 0.05 * h / 2, 20 + 5 * pulse, glow, pulse)
        self.oval(x, y - 0.05 * h / 2, 30 + 5 * pulse, 30 + 5 * pulse, outline=gold, width=3)

    # ---- hearts, score, messages -------------------------------
    def draw_hud(self):
        self.set_text(self.hud_level, "LEVEL %d / %d" % (self.level, FINAL_LEVEL))
        self.set_text(self.hud_score, "SCORE  %d" % self.score)
        self.set_text(self.hud_info, "CANNONS %d    FIRE %.1f/sec" %
                      (self.cannons, 60 / self.fire_delay * self.cannons))
        self.update_hearts()

    def update_hearts(self):
        """Hardcore hearts: 10 hearts, half hearts, white blink when hurt,
        and they shake when you are nearly dead."""
        c = self.canvas
        blink = self.hit_flash > 0 and (self.hit_flash // 4) % 2 == 0
        for i in range(HEARTS):
            whole = 2 * (i + 1)
            kind = "full" if self.hp >= whole else ("half" if self.hp == whole - 1 else "empty")
            key = (kind, blink)
            if self.heart_shown[i] != key:
                c.itemconfigure(self.heart_items[i], image=self.heart_imgs[key])
                self.heart_shown[i] = key
        shaking = 0 < self.hp <= 4
        if shaking or self.hearts_shaking:
            for i in range(HEARTS):
                x, y = self.heart_pos[i]
                c.coords(self.heart_items[i], x, y + (random.choice((-3, 0, 3)) if shaking else 0))
            self.hearts_shaking = shaking

    def draw_messages(self):
        c = self.canvas
        mid = WIDTH / 2
        if self.paused:
            stroke_text(c, "PAUSED", mid, 330, 8, 9, "#ffffff", "#6a3fc0", 3)
            self.text(mid, 390, "press P to continue", 13, "#d8c4ff", bold=False)

        if self.state == "playing" and self.banner > 0:
            if self.boss and self.level == FINAL_LEVEL:
                stroke_text(c, "FINAL BOSS", mid, 380, 6.5, 7.5, "#ffdd55", "#a01010", 3)
            elif self.boss:
                if (self.banner // 8) % 2 == 0:
                    stroke_text(c, "WARNING!", mid, 380, 6.5, 7.5, "#ff5566", "#601020", 3)
            elif self.banner > 20:
                stroke_text(c, "LEVEL %d" % self.level, mid, 330, 7, 8, "#ffffff", "#6a3fc0", 3)

        if self.state == "reward":
            stroke_text(c, "LEVEL %d CLEARED!" % self.level, mid, 250, 4.8, 6, "#7dffa0", "#146030", 3)
            self.text(mid, 315, "REWARD", 18, "#ffe066")
            for i, line in enumerate(self.reward_lines):
                self.text(mid, 355 + i * 30, line, 15, "#ffffff")

        if self.state == "gameover":
            stroke_text(c, "GAME OVER", mid, 270, 8, 9.5, "#ff5566", "#601020", 4)
            self.text(mid, 340, "You reached level %d   -   Score %d" % (self.level, self.score), 15)
            self.text(mid, 385, "Press  R  to try again", 15, "#ffe066")

        if self.state == "win":
            stroke_text(c, "YOU WIN!", mid, 250, 9, 10, "#7dffa0", "#146030", 4)
            self.text(mid, 325, "You destroyed the FINAL BOSS!", 16)
            self.text(mid, 360, "Final score: %d" % self.score, 16)
            self.text(mid, 405, "Press  R  to play again", 15, "#ffe066")

    # -----------------------------------------------------------
    # THE TITLE (ENTRANCE) SCREEN - the moving parts
    # (planet and letters were drawn once in build_title)
    # -----------------------------------------------------------
    def draw_title(self):
        c = self.canvas
        t = self.t
        mid = WIDTH / 2

        # glowing title colour cycles, the "press space" text blinks
        if self.draw_count % 4 == 0:
            cycle = 0.5 + 0.5 * math.sin(t * 0.04)
            c.itemconfigure("tglow", fill=mix("#5a2fd0", "#d02fb0", round(cycle, 1)))
        on = (t // 30) % 2 == 0
        if on != self.blink:
            c.itemconfigure("press", state="normal" if on else "hidden")
            self.blink = on
        if not self.sound.mode:
            self.set_text(self.title_sound, "(no sound player found on this computer)")

        # a boss floats in the middle, with circle minions orbiting it
        n = (t // 240) % 5
        bx, by = mid + 60 * math.sin(t * 0.015), 345 + 8 * math.sin(t * 0.04)
        hull, plate, glow = BOSS_PALETTES[n]
        pulse = 0.5 + 0.5 * math.sin(t * 0.12)
        [self.boss_warship, self.boss_manta, self.boss_fortress,
         self.boss_crab, self.boss_stinger][n](bx, by, 150, 90, hull, plate, glow, pulse)
        for k in range(6):
            a = t * 0.03 + k * math.pi / 3
            self.draw_minion(bx + math.cos(a) * 135, by + math.sin(a) * 52,
                             11, MINION_COLORS[k % len(MINION_COLORS)], t)

        # the player's ship hovers at the bottom
        self.draw_player(mid, 585 + 4 * math.sin(t * 0.07), 3)


