def make_heart_image(kind, blink):
    """kind is 'full', 'half' or 'empty'. Returns a PhotoImage."""
    img = tk.PhotoImage(width=9, height=9)
    for y, row in enumerate(HEART_MAP):
        for x, ch in enumerate(row):
            if ch == ".":
                continue
            filled = kind == "full" or (kind == "half" and x <= 4)
            img.put(HEART_COLORS[(filled, blink)][ch], to=(x, y))
    return img.zoom(HEART_ZOOM, HEART_ZOOM)


