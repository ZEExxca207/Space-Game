LETTER_GAP = 1.5


def text_units(text):
    total = 0
    for ch in text:
        total += 3 if ch == " " else GLYPHS.get(ch, (4, ()))[0] + LETTER_GAP
    return total - LETTER_GAP


def stroke_text(c, text, cx, cy, ux, uy, color, glow=None, width=3,
                tags=("dyn",), glow_tags=None):
    """Draw text in the SpaceX-style line font. ux/uy = size of one grid unit."""
    text = text.upper()
    x = cx - text_units(text) * ux / 2
    top = cy - 3 * uy
    lines = []
    for ch in text:
        if ch == " ":
            x += 3 * ux
            continue
        w, strokes = GLYPHS.get(ch, (4, ()))
        for s in strokes:
            flat = []
            for px, py in s:
                flat += [x + px * ux, top + py * uy]
            lines.append(flat)
        x += (w + LETTER_GAP) * ux
    if glow:  # soft glow behind the letters
        for flat in lines:
            c.create_line(flat, fill=glow, width=width + 6, capstyle="round",
                          joinstyle="round", tags=glow_tags or tags)
    for flat in lines:
        c.create_line(flat, fill=color, width=width, capstyle="round",
                      joinstyle="round", tags=tags)


# ---------------------------------------------------------------
# POOL: re-use canvas items instead of deleting and re-creating them
# (creating hundreds of items every frame is what makes slow laptops lag)
# ---------------------------------------------------------------
class Pool:
    def __init__(self, canvas, kind, **opts):
        self.c = canvas
        self.make = {"line": canvas.create_line, "oval": canvas.create_oval,
                     "rect": canvas.create_rectangle}[kind]
        self.opts = opts
        self.ids = []
        self.cols = []
        self.shown = 0

    def update(self, shapes, colors=None):
        c = self.c
        n = len(shapes)
        while len(self.ids) < n:
            self.ids.append(self.make(0, 0, 1, 1, state="hidden", **self.opts))
            self.cols.append(None)
        for i in range(n):
            c.coords(self.ids[i], *shapes[i])
            if colors is not None and self.cols[i] != colors[i]:
                c.itemconfigure(self.ids[i], fill=colors[i])
                self.cols[i] = colors[i]
        for i in range(self.shown, n):
            c.itemconfigure(self.ids[i], state="normal")
        for i in range(n, self.shown):
            c.itemconfigure(self.ids[i], state="hidden")
        self.shown = n


# ---------------------------------------------------------------
# SOUND  (made from scratch, no sound files needed)
# It is built and played in a separate thread, so it can never slow the game.
# ---------------------------------------------------------------
RATE = 11025


def _tone(f0, f1, dur, vol=0.4, kind="square", decay=2.0):
    """One beep that slides from frequency f0 to f1."""
    n = int(RATE * dur)
    out = []
    phase = 0.0
    prev = 0.0
    for i in range(n):
        p = i / n
        phase += (f0 + (f1 - f0) * p) / RATE
        ph = phase % 1.0
        if kind == "square":
            s = 1.0 if ph < 0.5 else -1.0
        elif kind == "pulse":
            s = 1.0 if ph < 0.25 else -1.0
        elif kind == "sine":
            s = math.sin(2 * math.pi * ph)
        else:  # rumbling noise
            prev = 0.7 * prev + 0.3 * random.uniform(-1, 1)
            s = prev * 2.2
        env = (1 - p) ** decay
        env *= min(1.0, i / (RATE * 0.004))      # tiny fade-in so it does not click
        out.append(s * vol * env)
    return out


def _notes(seq, kind="square", vol=0.3, decay=0.6):
    out = []
    for freq, dur in seq:
        out += [0.0] * int(RATE * dur) if freq == 0 else _tone(freq, freq, dur, vol, kind, decay)
    return out


def _wav_bytes(samples):
    pcm = array.array("h", [int(max(-1.0, min(1.0, s)) * 32000) for s in samples])
    if sys.byteorder == "big":
        pcm.byteswap()
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(pcm.tobytes())
    return buf.getvalue()


class Sound:
    """Makes a few little 8-bit sound effects and plays them."""

    GAPS = {"shoot": 0.14, "boom": 0.07, "hurt": 0.2, "fanfare": 0.5,
            "win": 0.5, "gameover": 0.5, "start": 0.5}

    def __init__(self):
        self.enabled = True
        self.mode = None
        self.ready = False
        self.busy_until = 0.0
        self.last = {}
        self.data = {}
        self.length = {}
        self.paths = {}
        self.folder = None
        self.q = queue.Queue()

        if sys.platform.startswith("win"):
            try:
                import winsound
                self.winsound = winsound
                self.mode = "win"
            except ImportError:
                pass
        elif sys.platform == "darwin":
            if shutil.which("afplay"):
                self.mode = "cmd"
                self.cmd = ["afplay"]
        else:
            for player in (["paplay"], ["aplay", "-q"]):
                if shutil.which(player[0]):
                    self.mode = "cmd"
                    self.cmd = player
                    break
        if self.mode:
            threading.Thread(target=self._worker, daemon=True).start()

    def build(self):
        C5, E5, G5, C6, E6, G6 = 523, 659, 784, 1047, 1319, 1568
        fanfare = _notes([(C5, .07), (E5, .07), (G5, .07), (C6, .07), (G5, .07), (C6, .07),
                          (E6, .13), (C6, .07), (E6, .07), (G6, .50)], "square", 0.28, 0.5)
        win = _notes([(C5, .09), (E5, .09), (G5, .09), (C6, .09), (E6, .09), (G6, .18),
                      (E6, .09), (G6, .09), (C6, .09), (E6, .09), (G6, .09), (1760, .18),
                      (G6, .09), (1760, .09), (2093, .7)], "square", 0.28, 0.5)
        sad = _notes([(392, .2), (370, .2), (349, .2), (330, .6)], "pulse", 0.35, 1.0)
        boom = [a + b for a, b in zip(_tone(0, 0, 0.22, 0.3, "noise", 2.4),
                                      _tone(190, 50, 0.22, 0.28, "sine", 1.5))]
        sounds = {
            "shoot": _tone(1500, 650, 0.07, 0.28, "square", 2.0),
            "boom": boom,
            "hurt": _tone(320, 80, 0.35, 0.4, "square", 1.2),
            "fanfare": fanfare,
            "win": win,
            "gameover": sad,
            "start": _tone(300, 1300, 0.35, 0.3, "square", 1.0)
                     + _notes([(1568, .12), (2093, .3)], "square", 0.25, 0.8),
        }
        for name, samples in sounds.items():
            self.data[name] = _wav_bytes(samples)
            self.length[name] = len(samples) / RATE
            self.last[name] = 0.0

    def _worker(self):
        try:
            self.build()
            if self.mode == "cmd":
                self.folder = tempfile.mkdtemp(prefix="spacegame_")
                atexit.register(shutil.rmtree, self.folder, True)
                for name, wav in self.data.items():
                    self.paths[name] = os.path.join(self.folder, name + ".wav")
                    with open(self.paths[name], "wb") as f:
                        f.write(wav)
            self.ready = True
        except Exception:
            self.mode = None
            return
        while True:
            name = self.q.get()
            if name is None:
                return
            try:
                if self.mode == "win":
                    self.winsound.PlaySound(self.data[name], self.winsound.SND_MEMORY)
                elif self.mode == "cmd":
                    subprocess.run(self.cmd + [self.paths[name]], stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
            except Exception:
                self.mode = None            # sound is broken here, just stay silent
                return

    def play(self, name, priority=False):
        """priority sounds (fanfare, hurt...) are never skipped because of shooting."""
        if not self.enabled or not self.ready or not self.mode:
            return
        now = time.time()
        if not priority and (now < self.busy_until or self.q.qsize() > 1):
            return
        if now - self.last[name] < self.GAPS[name]:
            return
        self.last[name] = now
        if priority:
            self.busy_until = now + self.length[name]
            try:
                while True:                  # throw away sounds that are still waiting
                    self.q.get_nowait()
            except queue.Empty:
                pass
        self.q.put(name)

    def stop(self):
        try:
            while True:
                self.q.get_nowait()
        except queue.Empty:
            pass
        if self.mode == "win":
            try:
                self.winsound.PlaySound(None, self.winsound.SND_PURGE)
            except Exception:
                pass


