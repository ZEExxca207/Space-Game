class Game:
    def __init__(self, root):
        self.root = root
        root.title("SpaceGame %s - made by Claude A.I and ZEE" % VERSION)
        root.resizable(False, False)

        self.canvas = tk.Canvas(root, width=WIDTH, height=HEIGHT,
                                bg="#07030f", highlightthickness=0)
        self.canvas.pack()
        self.sound = Sound()

        self.fps = DEFAULT_FPS if DEFAULT_FPS in FPS_CHOICES else 30
        self.fps_now = 0
        self.draw_count = 0
        self.errors = 0
        self.good_frames = 0
        self.t = 0                 # game-step counter (60 per second)
        self.paused = False
        self.state = "title"       # title / playing / reward / gameover / win
        self.scene = None
        self.blink = None
        self.text_cache = {}

        self.make_background()
        self.make_stars()
        self.reset()
        self.build_pools()
        self.build_title()
        self.build_hud()
        self.refresh_fps_text()

        self.keys = set()
        root.bind("<KeyPress>", self.key_down)
        root.bind("<KeyRelease>", self.key_up)
        root.bind("<FocusOut>", self.focus_out)
        root.protocol("WM_DELETE_WINDOW", self.close)
        root.focus_force()

        self.running = True
        self.acc = 0.0
        self.last_tick = time.perf_counter()
        self.fps_clock = self.last_tick
        self.loop()

    # -----------------------------------------------------------
    # Background: ONE picture (purple galaxy, or your own file)
    # -----------------------------------------------------------
    def make_background(self):
        c = self.canvas
        self.bg_photo = None
        folder = os.path.dirname(os.path.abspath(__file__))
        path = os.path.join(folder, BACKGROUND_FILE)
        if os.path.exists(path):
            try:
                self.bg_photo = tk.PhotoImage(file=path)
            except tk.TclError:
                self.bg_photo = None
        if self.bg_photo is None:
            try:
                self.bg_photo = self.make_galaxy()
            except Exception:
                traceback.print_exc()
        if self.bg_photo is not None:
            c.create_image(0, 0, image=self.bg_photo, anchor="nw", tags="bg")

    def make_galaxy(self):
        """Paint a small purple galaxy picture once, then zoom it up (fast!)."""
        w, h, z = 200, 234, 3
        top, bot = (5, 2, 13), (38, 16, 72)
        # (centre x, centre y, radius, colour, strength) in small-picture pixels
        blobs = [(50, 63, 66, (138, 43, 226), 0.55), (157, 110, 80, (75, 44, 201), 0.50),
                 (100, 190, 73, (192, 38, 156), 0.50), (23, 173, 50, (90, 47, 208), 0.45),
                 (177, 23, 50, (161, 58, 232), 0.50), (107, 110, 37, (122, 47, 208), 0.40)]
        band_col = (170, 110, 235)
        rows = []
        for y in range(h):
            g = (y / h) ** 1.3
            R = [top[0] + (bot[0] - top[0]) * g] * w
            G = [top[1] + (bot[1] - top[1]) * g] * w
            B = [top[2] + (bot[2] - top[2]) * g] * w
            for bx, by, rad, col, k in blobs:                 # nebula clouds
                dy = (y - by) / (rad * 0.8)
                if abs(dy) >= 1:
                    continue
                half = rad * math.sqrt(1 - dy * dy)
                for x in range(max(0, int(bx - half)), min(w, int(bx + half) + 1)):
                    dx = (x - bx) / rad
                    d = dx * dx + dy * dy
                    if d < 1:
                        f = (1 - d) ** 2 * k
                        R[x] += (col[0] - R[x]) * f
                        G[x] += (col[1] - G[x]) * f
                        B[x] += (col[2] - B[x]) * f
            c0 = 0.67 * 100 + 0.74 * 117                      # a soft band across the sky
            xa = int((c0 - 0.74 * y - 36) / 0.67)
            xb = int((c0 - 0.74 * y + 36) / 0.67)
            for x in range(max(0, xa), min(w, xb + 1)):
                n = (x * 0.67 + y * 0.74 - c0) / 36.0
                if abs(n) < 1:
                    f = (1 - n * n) * 0.22
                    R[x] += (band_col[0] - R[x]) * f
                    G[x] += (band_col[1] - G[x]) * f
                    B[x] += (band_col[2] - B[x]) * f
            rows.append("{" + " ".join("#%02x%02x%02x" % (int(R[x]), int(G[x]), int(B[x]))
                                       for x in range(w)) + "}")
        small = tk.PhotoImage(width=w, height=h)
        small.put(" ".join(rows), to=(0, 0))
        big = small.zoom(z, z)
        rng = random.Random(7)                                # tiny dust stars, painted in
        for _ in range(240):
            tt = rng.random()
            x = int(tt * (WIDTH + 100) - 50)
            y = int((1 - tt) * HEIGHT * 0.9 + rng.gauss(0, 55))
            if 0 <= x < w * z and 0 <= y < h * z:
                big.put(rng.choice(["#8e6bd8", "#b48cf0", "#e0b4ff", "#6a52b8"]), to=(x, y))
        return big

    def make_stars(self):
        c = self.canvas
        self.stars = []                     # moving stars (they scroll down)
        for _ in range(55):
            size = random.choice([1, 1, 2, 2, 3])
            x, y = random.randint(0, WIDTH), random.randint(0, HEIGHT)
            item = c.create_oval(x, y, x + size, y + size, fill=random.choice(STAR_COLORS),
                                 outline="", tags="bg")
            self.stars.append([item, x, y, 0.3 + size * 0.45, size])

    def update_stars(self):
        for s in self.stars:
            s[2] += s[3]
            if s[2] > HEIGHT:
                s[2] = -4
                s[1] = random.randint(0, WIDTH)

    def draw_stars(self):
        c = self.canvas
        for item, x, y, speed, size in self.stars:
            c.coords(item, x, y, x + size, y + size)

